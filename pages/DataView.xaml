<UserControl x:Class="Aspan_Ground.pages.DataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aspan_Ground.pages"
             xmlns:atoms="clr-namespace:Aspan_Ground.components.atoms"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid Background="#FF1B1F23">
            <WrapPanel Orientation="Horizontal" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                <atoms:DataLabels Width="480" Margin="0,0,20,0">
                    <atoms:DataLabels.LayoutTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                    </atoms:DataLabels.LayoutTransform>
                </atoms:DataLabels>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
