<UserControl x:Class="Aspan_Ground.pages.MissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aspan_Ground.pages"
             xmlns:services="clr-namespace:Aspan_Ground.services"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             xmlns:molecules="clr-namespace:Aspan_Ground.components.molecules"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>
        <Grid Background="#FF1B1F23">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Harita Alanı (Sol Üst 2x2 Bölge) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" 
                    Margin="10" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <gmap:GMapControl x:Name="MapControl" />
            </Border>

            <!-- Sağ Taraf Panel (Görev Ayarları) -->
            <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" 
                    Margin="0,10,10,10" Background="#FF21262D" CornerRadius="8" BorderBrush="#30363D" BorderThickness="1">
                <StackPanel Margin="20">
                    <TextBlock Text="Görev Koordinasyonu" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
                    
                    <Border Background="#FF1B1F23" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Uçuş Kartındaki Görev: " Foreground="LightGray" FontSize="14"/>
                            <TextBlock Text="{Binding currentMissionStatus, Source={x:Static services:DataDesc.Instance}}" Foreground="LimeGreen" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="FillAreaCb" Content="Alanı Doldur" 
                              Foreground="LightGray" FontSize="14" Cursor="Hand" Click="FillAreaCb_Click" />
                              
                    <!-- YENİ EKLENEN GÖREV YÜKLE BUTONU -->
                    <Button Content="Görevleri Karta Yükle" 
                            Background="#FF238636" Foreground="White" FontSize="14" FontWeight="Bold" 
                            Height="35" Cursor="Hand" BorderThickness="0" Margin="0,15,0,0" Click="UploadMission_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Alt Taraf Panel (Görev Datagrid) -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                    Margin="10,0,10,10" Background="#FF21262D" CornerRadius="8" BorderBrush="#30363D" BorderThickness="1">
                <DataGrid x:Name="WpDataGrid" AutoGenerateColumns="False" HeadersVisibility="Column" 
                          CanUserAddRows="False" Background="Transparent" RowBackground="Transparent"
                          Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#30363D"
                          BorderThickness="0" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding Index}" Width="40" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Lat" Binding="{Binding Lat}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Long" Binding="{Binding Lng}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Alt (m)" Binding="{Binding Alt}" Width="80" />
                        <DataGridTemplateColumn Header="İşlem" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Yukarı Taşı Button -->
                                        <Button Content="▲" Click="MoveWpUp_Click" Tag="{Binding Index}" Width="25" Height="25" Margin="0,0,5,0"
                                                Background="#FF234B23" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Yukarı Kaydır" />

                                        <!-- Aşağı Taşı Button -->
                                        <Button Content="▼" Click="MoveWpDown_Click" Tag="{Binding Index}" Width="25" Height="25" Margin="0,0,5,0"
                                                Background="#FF172A4A" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Aşağı Kaydır" />

                                        <!-- Sil Button -->
                                        <Button Content="X" Click="DeleteWp_Click" Tag="{Binding Index}" Width="25" Height="25"
                                                Background="#FF4A1717" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Sil" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF1B1F23"/>
                            <Setter Property="Foreground" Value="LightGray"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#FF21262D" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF30363D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="5,0"/>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </Border>

        </Grid>
        
        <!-- Hata ve Bilgi Mesajları İçin Component -->
        <molecules:alerts x:Name="MissionAlert" />
    </Grid>
</UserControl>
