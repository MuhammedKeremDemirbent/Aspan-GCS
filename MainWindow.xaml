<mah:MetroWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aspan_Ground"
        xmlns:pages="clr-namespace:Aspan_Ground.pages"
        
        xmlns:molecules="clr-namespace:Aspan_Ground.components.molecules"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="Aspan_Ground.MainWindow"
        mc:Ignorable="d"
        Title=""
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        TitleCharacterCasing="Normal"
        GlowBrush="#00D4FF"
        BorderThickness="1"
        WindowTitleBrush="#FF1B1F23"
        NonActiveWindowTitleBrush="#FF1B1F23"
        FontFamily="pack://application:,,,/assets/fonts/Inter/#Inter">

    <Window.Resources>
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="36,15"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <TextBlock Text="{TemplateBinding Header}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00D4FF"/>
                                <Setter Property="Foreground" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0D1117">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST PANEL ALANI -->
        <molecules:UpperPanel x:Name="TopPanel" 
                              Grid.Row="0" Grid.ColumnSpan="2" 
                              RequestDisconnect="TopPanel_RequestDisconnect"/>

        <!-- TAB CONTROL -->
        <mah:MetroAnimatedSingleRowTabControl
                Grid.Row="1"
                Background="#0D1117"
                BorderThickness="0"
                TabStripPlacement="Top" Grid.ColumnSpan="2">

            <mah:MetroAnimatedSingleRowTabControl.Resources>
                <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="#00D4FF"/>
            </mah:MetroAnimatedSingleRowTabControl.Resources>

            <mah:MetroAnimatedSingleRowTabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#212A39"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#21262D"
                                Padding="0,3">
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                        </Border>
                        <Border Grid.Row="1" Background="#0D1117">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </mah:MetroAnimatedSingleRowTabControl.Template>

            <!-- WATCH -->
            <TabItem Header="WATCH" Style="{StaticResource ModernTabItemStyle}">
                <pages:WatchView />
            </TabItem>

            <!-- GRAPH -->
            <TabItem Header="GRAPH" Style="{StaticResource ModernTabItemStyle}">
                <pages:GraphView />
            </TabItem>

            <!-- DATA -->
            <TabItem Header="DATA" Style="{StaticResource ModernTabItemStyle}">
                <pages:DataView />
            </TabItem>

            <!-- PID -->
            <TabItem Header="PID" Style="{StaticResource ModernTabItemStyle}">
                <pages:PIDView />
            </TabItem>

            <!-- MISSION -->
            <TabItem Header="MISSION" Style="{StaticResource ModernTabItemStyle}">
                <pages:MissionView />
            </TabItem>

            <!-- INFO -->
            <TabItem Header="INFO" Style="{StaticResource ModernTabItemStyle}">
                <pages:InfoView />
            </TabItem>

            <!-- LOGS -->
            <TabItem Header="LOGS" Style="{StaticResource ModernTabItemStyle}">
                <pages:LogsView />
            </TabItem>

        </mah:MetroAnimatedSingleRowTabControl>

        <!-- ALERTS OVERLAY -->
        <molecules:alerts x:Name="MainAlert" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="999" RenderTransformOrigin="0.458,0.511" />
    </Grid>

</mah:MetroWindow>
