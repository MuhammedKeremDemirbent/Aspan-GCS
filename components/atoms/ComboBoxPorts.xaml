<UserControl x:Class="Aspan_Ground.components.atoms.ComboBoxPorts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aspan_Ground.components.atoms"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  
  
    <Border Background="#FF1B1F23" CornerRadius="6"
            BorderBrush="#30363D" BorderThickness="1"
            VerticalAlignment="Center" Margin="0,0,8,0">
        <ComboBox x:Name="CbPort"
                  DropDownOpened="CbPort_DropDownOpened"
                  Width="110" Height="34"
                  Background="Transparent"
                  Foreground="#E6EDF3"
                  BorderThickness="0"
                  FontSize="12" FontWeight="SemiBold"
                  Padding="10,0"
                  VerticalContentAlignment="Center">
            <ComboBox.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1B1F23"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#30363D"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#00D4FF"/>
            </ComboBox.Resources>
        </ComboBox>
    </Border>
</UserControl>
