<UserControl x:Class="Aspan_Ground.components.atoms.UpperPanelLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aspan_Ground.components.atoms"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="200">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#30363D"/>
        <SolidColorBrush x:Key="CheckingBrush" Color="#E28743"/>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#3FB950"/>
    </UserControl.Resources>

    <Border x:Name="StatusBorder" 
            BorderThickness="1" 
            CornerRadius="6" 
            Background="#FF1B1F23" 
            Padding="0" 
            Width="130"
            Height="34"
            VerticalAlignment="Center">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource DisconnectedBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Checking">
                        <Setter Property="BorderBrush" Value="{StaticResource CheckingBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Connected">
                        <Setter Property="BorderBrush" Value="{StaticResource ConnectedBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <TextBlock Text="NO CONNECTION" 
                       Foreground="#8B949E" 
                       FontSize="11" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Disconnected">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="CHECKING..." 
                       Foreground="#E28743" 
                       FontSize="11" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Checking">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="CONNECTED" 
                       Foreground="#3FB950" 
                       FontSize="11" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Connected">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
