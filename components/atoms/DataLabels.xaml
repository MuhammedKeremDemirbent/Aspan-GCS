<UserControl x:Class="Aspan_Ground.components.atoms.DataLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aspan_Ground.components.atoms"
             xmlns:services="clr-namespace:Aspan_Ground.services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300">
             
    <!-- DataContext code-behind (DataLabels.xaml.cs) üzerinden DataDesc.Instance'a ayarlandı -->

    <Border Background="#161B22" CornerRadius="8" BorderBrush="#30363D" BorderThickness="1" Padding="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/> <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/> <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. KOLON: DYNAMICS -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FLIGHT DYNAMICS" Foreground="#8B949E" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" />

                    <TextBlock Text="ATTITUDE &amp; MOTION" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Roll:" Foreground="#C9D1D9" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentRoll, StringFormat={}{0:F2}°}" Foreground="White" FontWeight="Bold" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Pitch:" Foreground="#C9D1D9" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentPitch, StringFormat={}{0:F2}°}" Foreground="White" FontWeight="Bold" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Yaw:" Foreground="#C9D1D9" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentYaw, StringFormat={}{0:F2}°}" Foreground="White" FontWeight="Bold" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Text="Altitude:" Foreground="#C9D1D9" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentAltitude, StringFormat={}{0:F1} m}" Foreground="White" FontWeight="Bold" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Hor Speed:" Foreground="#C9D1D9" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentHorizontalSpeed, StringFormat={}{0:F1} m/s}" Foreground="White" FontWeight="Bold" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Text="Ver Speed:" Foreground="#C9D1D9" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentVerticalSpeed, StringFormat={}{0:F1} m/s}" Foreground="White" FontWeight="Bold" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,5,0,10"/>

                    <TextBlock Text="SETPOINTS" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Roll Set:" Foreground="#8B949E" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding rollSetpoint, StringFormat={}{0:F2}°}" Foreground="#8B949E" FontWeight="Bold" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Pitch Set:" Foreground="#8B949E" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding pitchSetpoint, StringFormat={}{0:F2}°}" Foreground="#8B949E" FontWeight="Bold" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Yaw Set:" Foreground="#8B949E" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding yawSetpoint, StringFormat={}{0:F2}°}" Foreground="#8B949E" FontWeight="Bold" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Separator 1 -->
                <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#30363D" Margin="19,0" Width="1" HorizontalAlignment="Center"/>

                <!-- 2. KOLON: GPS & SYSTEM -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SYSTEM STATUS" Foreground="#8B949E" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" />

                    <TextBlock Text="GPS &amp; POWER" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Latitude:" Foreground="#C9D1D9" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentLat, StringFormat={}{0:F7}}" Foreground="White" FontWeight="Bold" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Longitude:" Foreground="#C9D1D9" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentLon, StringFormat={}{0:F7}}" Foreground="White" FontWeight="Bold" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Battery:" Foreground="#C9D1D9" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentBattery, StringFormat={}{0}%}" Foreground="White" FontWeight="Bold" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Satellites:" Foreground="#C9D1D9" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentSatellites, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Text="Model ID:" Foreground="#C9D1D9" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentModelID, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="Free1:" Foreground="#C9D1D9" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentFree1, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Separator 2 -->
                <Separator Grid.Column="3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#30363D" Margin="19,0" Width="1" HorizontalAlignment="Center"/>

                <!-- 3. KOLON: RC CHANNELS -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="RC CONTROL" Foreground="#8B949E" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" />

                    <TextBlock Text="INPUT CHANNELS" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="CH 1 (RH):" Foreground="#C9D1D9" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentRH, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 2 (RV):" Foreground="#C9D1D9" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentRV, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 3 (LH):" Foreground="#C9D1D9" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentLH, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 4 (LV):" Foreground="#C9D1D9" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentLV, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 5:" Foreground="#C9D1D9" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentChannel5, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 6:" Foreground="#C9D1D9" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentChannel6, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 7:" Foreground="#C9D1D9" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentChannel7, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        
                        <TextBlock Text="CH 8:" Foreground="#C9D1D9" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding currentChannel8, StringFormat={}{0}}" Foreground="White" FontWeight="Bold" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
