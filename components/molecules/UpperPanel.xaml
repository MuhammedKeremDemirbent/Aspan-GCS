<UserControl x:Class="Aspan_Ground.components.molecules.UpperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:atoms="clr-namespace:Aspan_Ground.components.atoms"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#FF1B1F23"
            BorderThickness="0,0,0,1"
            BorderBrush="#21262D">

        <Grid Height="70" Margin="0,0,0,10">
            <!-- Sol Panel: UYGULAMA İSMİ -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Left" 
                        Margin="25,-20,0,0" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0"/>
                        <RotateTransform/>
                        <TranslateTransform X="0"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <TextBlock Text="ASPAN" 
                           Foreground="LightSkyBlue" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>

                <TextBlock Text="GROUND" 
                           Foreground="White" 
                           FontSize="28" 
                           FontWeight="Light" 
                           VerticalAlignment="Center"/>

            </StackPanel>

            <!-- Sağ Panel: KONTROLLER -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,-20,24,0">

                <atoms:UpperPanelLabels x:Name="ConnectionLabels" Margin="0,0,20,0" />
                <atoms:ComboBoxPorts x:Name="PortSelector" />
                <atoms:ComboBoxBaudRates x:Name="BaudSelector" />
                <atoms:ConnectButton x:Name="BtnConnectControl" />
                <atoms:DisconnectButton x:Name="BtnDisconnectControl" />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
