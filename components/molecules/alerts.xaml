<UserControl x:Class="Aspan_Ground.components.molecules.alerts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aspan_Ground.components.molecules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- HAYIR Butonu Hover Stili -->
        <Style x:Key="AlertBtnNoStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D333B"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- EVET Butonu Hover Stili -->
        <Style x:Key="AlertBtnYesStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91D1A"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#8F1614"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- TAMAM Butonu Hover Stili -->
        <Style x:Key="AlertBtnOkStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A6B29"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#104F1A"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="AlertOverlay">

        <!-- Popup: WindowsFormsHost dahil her şeyin üstünde render edilir -->
        <Popup x:Name="AlertPopup" Placement="Absolute" AllowsTransparency="True" StaysOpen="True">
            
            <!-- Tüm pencereyi kaplayan karartma Grid -->
            <Grid x:Name="DimGrid" Background="Transparent">
                
                <!-- Alert Kutusu: tam ortada -->
                <Border Background="#161B22" 
                        BorderBrush="#30363D" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Width="320" 
                        Height="180" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Effect="{DynamicResource MahApps.DropShadowEffect.Depth3}">
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <TextBlock Grid.Row="0" 
                                   x:Name="AlertTitle"
                                   Text="DİKKAT" 
                                   Foreground="#F85149" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Margin="0,15,0,5" 
                                   HorizontalAlignment="Center"/>

                        <!-- Mesaj İçeriği -->
                        <TextBlock Grid.Row="1" 
                                   x:Name="AlertMessage"
                                   Text="Çıkmak istediğinize emin misiniz?&#x0a;Bağlantı kopacak." 
                                   Foreground="#C9D1D9" 
                                   FontSize="13" 
                                   Margin="20,10,20,10" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   VerticalAlignment="Center"/>

                        <!-- Butonlar -->
                        <StackPanel Grid.Row="2" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,0,0,15">
                            
                            <!-- HAYIR Butonu -->
                            <Button x:Name="BtnNo" 
                                    Content="HAYIR" 
                                    Width="100" 
                                    Height="32" 
                                    Margin="0,0,10,0"
                                    Foreground="#C9D1D9"
                                    Background="#21262D"
                                    BorderBrush="#30363D"
                                    BorderThickness="1"
                                    Style="{StaticResource AlertBtnNoStyle}"
                                    Click="BtnNo_Click"/>

                            <!-- EVET Butonu -->
                            <Button x:Name="BtnYes" 
                                    Content="EVET" 
                                    Width="100" 
                                    Height="32"
                                    Foreground="White"
                                    Background="#DA3633"
                                    BorderBrush="#F85149"
                                    BorderThickness="1"
                                    Style="{StaticResource AlertBtnYesStyle}"
                                    Click="BtnYes_Click"/>
                            
                            <!-- TAMAM (OK) Butonu -->
                            <Button x:Name="BtnOk" 
                                    Content="TAMAM" 
                                    Width="100" 
                                    Height="32"
                                    Foreground="White"
                                    Background="#238636"
                                    BorderBrush="#2EA043"
                                    BorderThickness="1"
                                    Style="{StaticResource AlertBtnOkStyle}"
                                    Visibility="Collapsed"
                                    Click="BtnOk_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
